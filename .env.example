# Supabase Postgres connection string.
# Use the "Transaction" pooler URI from the Supabase dashboard for serverless
# (Vercel Functions). Format: postgres://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Long random string for signing JWTs.
JWT_SECRET=

# Supabase Storage credentials for image uploads (server-side only).
# SUPABASE_URL is the project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the service-role key — NEVER expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
